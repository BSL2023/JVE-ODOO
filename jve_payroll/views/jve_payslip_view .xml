    <record id="view_contract_information" model="ir.ui.view">
        <field name="name">view.contract.information</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook/page[2]/group/group[1]/div[@name='wage']"
                   position="after">
                <field name="sursalaire"/>
            </xpath>

            <xpath expr="//form/sheet/notebook/page[@name='information']" position="replace">
                <page name="information" groups="bos_odoo.group_admin_rh, bos_odoo.group_assistant_rh, bos_odoo.group_resp_paie"/>
            </xpath>

            <xpath expr="//form/sheet/notebook/page[2]/group" position="replace">
                <group string="Eléments du salarié">
                    <group>
                        <field name="wage"/>
                        <field name="sursalaire"/>
                    </group>
                    <group>
                        <field name="carburant"/>
                        <field name="rappel"/>
                        <field name="avantage_nat"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//form/sheet/notebook/page[2]/group" position="after">
                <group string="Primes">
                    <group>
                        <field name="prime_excep"/>
                        <field name="prime_fonct"/>
                        <field name="prime_salissure"/>
                        <field name="restaurant"/>
                        <field name="prime_rend"/>
                    </group>
                    <group>
                        <field name="prime_tel"/>
                        <field name="prime_logement"/>
                        <field name="indemnite_transport"/>
                        <field name="prime_fin_annee"/>
                    </group>
                </group>
                <group string="Avances">
                    <group>
                        <field name="acompte_salaire"/>
                        <field name="avance_tabaski"/>
                        <field name="date_acompte"/>
                    </group>
                    <group>
                        <field name="avance_korite"/>
                        <field name="avance_noel"/>
                    </group>
                </group>
                <group string="Retenues">
                    <group>
                        <field name="retenue_assurance"/>
                    </group>
                </group>
                <group string="Indemnités">
                    <group>
                        <field name="indemnite_preavis"/>
                        <field name="compens_preavis"/>
                    </group>
                    <group>
                        <field name="indemnite_conge"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//form/sheet/notebook/page[@name='information']" position="replace">
                <page name="information" groups="bos_odoo.group_admin_rh, bos_odoo.group_assistant_rh, bos_odoo.group_resp_paie"/>
            </xpath>

            <xpath expr="//form/sheet/group/group[2]/field[@name='job_id']" position="replace">
                <field name="job_id" readonly="1"/>
            </xpath>
            <xpath expr="//form/sheet/group/group[1]/field[@name='structure_type_id']" position="replace">
                <field name="structure_type_id" invisible="1"/>
            </xpath>
            <xpath expr="//form/sheet/group/group[1]/field[@name='structure_type_id']" position="after">
                <field name="structure_name_id"/>
            </xpath>
            <xpath expr="//form/sheet/group/group[2]/field[@name='contract_type_id']"
                   position="after">
                <field name="category"/>
                <field name="parent_id" readonly="1"/> 
                <field name="trimf"/>
            </xpath>
            <xpath expr="//form/sheet/group/group[2]/field[@name='hr_responsible_id']"
                   position="replace">
                <field name="hr_responsible_id" invisible="1"/>
            </xpath>
            <xpath expr="//form/sheet/notebook/page[2]/group/group[1]"
                   position="after">
                <group string="Primes">
                    <field name="prime_excep"/>
                    <field name="prime_respons"/>
                    <field name="prime_salissure"/>
                    <field name="restaurant"/>
                    <field name="prime_rend"/>
                </group>
                <group>
                    <field name="prime_risque"/>
                    <field name="prime_logement"/>
                    <field name="indemnite_transport"/>
                    <field name="prime_fin_annee"/>
                    &lt;!&ndash;                    <field name="anciennete"/>&ndash;&gt;
                    &lt;!&ndash;                    <field name="indemnite_conge"/>&ndash;&gt;
                    &lt;!&ndash;                    <field name="treizieme_mois"/>&ndash;&gt;
                    &lt;!&ndash;                    <field name="indemnite_fonction"/>&ndash;&gt;
                    &lt;!&ndash;                    <field name="indemnite_telephone"/>&ndash;&gt;
                </group>
            </xpath>
        </field>
    </record>

