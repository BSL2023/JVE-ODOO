    <record id="view_payslip_information" model="ir.ui.view">
        <field name="name">view.payslip.information</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/group/field[@name='struct_id']" position="after">
                <field name="nbre_parts_trimf"/>
                <field name="trimf"/>
                <!-- <field name="mode_paiement"/>
                <field name="employ_matr"/>
                <field name="bank"/>
                <field name="bank_number"/> -->
                <field name="salaire_brut" invisible="1"/>
                <field name="salaire_net" invisible="1"/>
                <field name="salaire_moyen" invisible="1"/>
                <field name="indemn_licenciement" invisible="1"/>
                <field name="indemn_retraite" invisible="1"/>
                <field name="indemn_deces" invisible="1"/>
                <field name="indemn_fin_cdd" invisible="1"/>
                <field name="total_imposable" invisible="1"/>
                <field name="montant_anciennete" invisible="1"/> 
                <field name="total_cotisation_employe" invisible="1"/>
                <field name="total_cotisation_employeur" invisible="1"/>
                <field name="total_non_imposable" invisible="1"/>
                <field name="total_cotisation" invisible="1"/>
                <field name="salaire_base" invisible="1"/>
                <field name="sursalaire" invisible="1"/>
                <field name="montant_allocation_familiale" invisible="1"/>
                <field name="montant_accident_travail" invisible="1"/>
                <field name="montant_cfce" invisible="1"/>
                <field name="impot_revenu" invisible="1"/>
                <field name="base_fiscal_abatt" invisible="1"/>
                <field name="montant_ipress_general_employee" invisible="1"/>
                <field name="montant_ipress_general_employeur" invisible="1"/>
                <field name="montant_ipress_cadre_employe" invisible="1"/>
                <field name="montant_ipress_cadre_employeur" invisible="1"/>
                <field name="all_cotisation_employe_general" invisible="1"/>
                <field name="all_cotisation_employeur_general" invisible="1"/>
                <field name="all_cotisation_employe_cadre" invisible="1"/>
                <field name="all_cotisation_employeur_cadre" invisible="1"/>
                <field name="total_ipress_cadre" invisible="1"/>
                <field name="total_ipress_general" invisible="1"/>
                <field name="total_ipress" invisible="1"/>
                <field name="total_retenue" invisible="1"/>
                <field name="base_global_general" invisible="1"/>
                <field name="base_global_cadre" invisible="1"/>
                <field name="indemnite_transport" invisible="1"/>
                <field name="regime_general_employe_employeur" invisible="1"/>
                <field name="regime_cadre_employe_employeur" invisible="1"/>
                <field name="caisse_ss" invisible="1"/>
            </xpath>
            <xpath expr="//form/sheet/notebook/page[@name='worked_days_input']/field[@name='worked_days_line_ids']" position="replace">
                <field name="worked_days_line_ids" readonly="state in ['cancel', 'done', 'paid']" invisible=" not use_worked_day_lines">
                    <list string="Worked Days" editable="bottom" create="0" delete="0">
                        <field name="work_entry_type_id" readonly="1" force_save="1"/>
                        <field name="name"/>
                        <field name="number_of_days" sum="Total Working Days" force_save="1"/>
                        <field name="number_of_hours"  widget="float_time" sum="Total Working Hours" force_save="1"/>
                        <field name="amount" readonly="1" sum="Total Amount" force_save="1"/>
                        <field name="ytd" readonly="1" force_save="1"
                            column_invisible="not parent.ytd_computation"
                            optional="show"/>
                        <field name="is_paid" readonly="1" column_invisible="True" force_save="1"/>
                        <field name="sequence" readonly="1" column_invisible="True" force_save="1"/>
                        <field name="currency_id" column_invisible="True"/>
                    </list>
                    <form string="Worked Day">
                        <group col="4">
                            <field name="work_entry_type_id"/>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="number_of_days"/>
                            <field name="number_of_hours" widget="float_time"/>
                            <field name="amount"/>
                            <field name="ytd" readonly="1" invisible="not parent.ytd_computation"/>
                            <field name="is_paid"/>
                            <field name="contract_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </form>
                </field>
            </xpath>
        </field>
    </record>

