<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_contract_information" model="ir.ui.view">
        <field name="name">view.contract.information</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group/group[2]/field[@name='job_id']"
                   position="after">
                <field name="category"/>
                <field name="societe"/>
            </xpath>
            <!-- <xpath expr="//form/sheet/group/group[1]/field[@name='date_end']"
                   position="after">
                <field name="nbre_parts"/>
                <field name="anciennete"/>
            </xpath> -->
            <xpath expr="//form/sheet/group/group[2]/field[@name='structure_type_id']"
                   position="replace">
                <field name="structure_type_id" groups="hr_contract.group_hr_contract_manager" options="{'no_open': True, 'no_create': True}" invisible="1"/>
            </xpath>
            <xpath expr="//form/sheet/group/group[2]/field[@name='department_id']"
                   position="before">
                <field name="structure_name_id"/>
            </xpath>
            <xpath expr="//form/sheet/notebook/page[@name='information']/group" position="replace">
                <group string="Eléments du salarié">
                    <group>
                        <field name="wage"/>
                    </group>
                    <group>
                        <field name="sursalaire"/>
                    </group>
                </group>
                <group string="Indemnités">
                    <group>
                        <field name="indemnite_tel"/>
                        <field name="prime_panier"/>
                        <field name="prime_panier_impos"/>
                        <field name="indemn_logement"/>
                        <field name="indemnite_kilom"/>
                        <field name="indemnite_kilom_com"/>
                        <field name="indemnite_kilom_impos"/>
                        <!-- <field name="indenm_fin_contract"/>
                        <field name="indemn_retraite"/> -->
                    </group>
                    <group>
                        <field name="indemnite_transport"/>
                        <field name="indemnite_transport_impos"/>
                        <!-- <field name="indemn_licenc"/>
                        <field name="indemn_deces"/> -->
                        <field name="carburant"/>
                        <field name="indemnite_respon"/>
                    </group>
                </group>
                <group string="Retenues">
                    <group>
                        <field name="retenue"/>
                    </group>
                </group>
            </xpath>
            <!-- <xpath expr="//form/sheet/notebook/page[@name='other']/group[@name='contract_details_0']" position="replace">
                <group></group>
            </xpath>
            <xpath expr="//form/sheet/notebook/page[@name='other']/group[@name='contract_details']" position="replace">
                <group></group>
            </xpath>
            <xpath expr="//form/sheet/notebook/page[@name='other']/group[@name='contract_details_2']" position="replace">
                <group></group>
            </xpath> -->
            <xpath expr="//form/sheet/notebook/page[@name='other']/group[@name='notes_group']" position="replace">
                <group string="Motif de sortie">
                    <group>
                        <field name="sortie"/> 
                    </group>
                    <group>
                        <field name="motif" invisible="not sortie"/>
                    </group>
                </group>
                <group string="NOTES">
                    <group>
                        <field name="notes" nolabel="1" placeholder="Type in notes about this contract..."/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_hr_salary_categories_tree" model="ir.ui.view">
        <field name="name">view.hr.salary.categories.tree</field>
        <field name="model">hr.salary</field>
        <!--<field name="type">tree</field>-->
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_hr_salary_categories_form" model="ir.ui.view">
        <field name="name">view.hr.salary.categories.form</field>
        <field name="model">hr.salary</field>
        <!--<field name="type">form</field>-->
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="salary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_menu_hr_category_salary" model="ir.actions.act_window">
        <field name="name">Salaires catégoriels</field>
        <field name="res_model">hr.salary</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une catégorie
            </p>
        </field>
    </record>

    <menuitem
            id="menu_hr_category_salary"
            name="Catégories"
            action="action_menu_hr_category_salary"
            parent="hr_payroll.menu_hr_salary_configuration"
            sequence="42"
    />

